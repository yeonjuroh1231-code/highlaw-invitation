var SHEET_ID = '1sbMN2QQCywQEk-eVLRLZX4YzsVvnI1hVtU7rHZjREOo';

function doPost(e) {
  try {
    var ss   = SpreadsheetApp.openById(SHEET_ID);
    var data = JSON.parse(e.postData.contents);

    // 어떤 시트에 저장할지 결정
    var sheetName = data.sheet === 'office_visit' ? '사무실방문' : 'RSVP';
    var sheet = ss.getSheetByName(sheetName);

    if (!sheet) {
      sheet = ss.insertSheet(sheetName);
      if (sheetName === 'RSVP') {
        sheet.appendRow(['응답시각','이름','소속','연락처','참석여부','동반인원','한마디']);
      } else {
        sheet.appendRow(['응답시각','이름','소속','연락처','방문날짜','방문시간','동반인원','한마디']);
      }
      sheet.getRange(1,1,1,sheet.getLastColumn()).setFontWeight('bold').setBackground('#1a0a2e').setFontColor('#ffffff');
    }

    if (sheetName === 'RSVP') {
      sheet.appendRow([
        new Date().toLocaleString('ko-KR'),
        data.name || '', data.org || '', data.phone || '',
        data.attend === 'yes' ? '참석' : '불참',
        data.attend === 'yes' ? (data.guests || 1) : 0,
        data.msg || ''
      ]);
    } else {
      sheet.appendRow([
        new Date().toLocaleString('ko-KR'),
        data.name || '', data.org || '', data.phone || '',
        data.visit_date || '', data.visit_time || '',
        data.guests || 1, data.msg || ''
      ]);
    }

    return ContentService.createTextOutput(JSON.stringify({result:'ok'})).setMimeType(ContentService.MimeType.JSON);
  } catch(err) {
    return ContentService.createTextOutput(JSON.stringify({result:'error',message:err.toString()})).setMimeType(ContentService.MimeType.JSON);
  }
}

function doGet(e) {
  return ContentService.createTextOutput(JSON.stringify({result:'ok',message:'HIGHLAW API running'})).setMimeType(ContentService.MimeType.JSON);
}
